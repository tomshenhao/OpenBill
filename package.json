{
  "name": "openbill",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Independent, privacy-first bill comparisons for New Zealand households.",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run data:validate",
    "data:validate": "node tools/electricity/cli.ts validate",
    "data:archive": "node tools/electricity/cli.ts archive",
    "data:import": "node tools/electricity/cli.ts import",
    "data:review": "node tools/electricity/cli.ts review",
    "data:query": "node tools/electricity/cli.ts query",
    "data:capture": "node tools/electricity/cli.ts capture",
    "data:stage-evidence": "node tools/electricity/cli.ts stage-evidence"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
