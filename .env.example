# The local app needs no credentials or environment configuration.
# Disable Next.js build/development telemetry (not household input telemetry).
NEXT_TELEMETRY_DISABLED=1

# Optional LAN development only: exact server IP/hostname as opened in the browser.
# Comma-separated hostnames, without schemes, ports, paths or wildcards.
# Set in ignored .env.local, or the shell, before npm run dev:lan; restart after changes.
# OPENBILL_DEV_ORIGINS=192.168.1.10,openbill.local
